{
  "manifest_version": 3,
  "name": "CatchUp Universal",
  "version": "1.0.0",
  "description": "AI-powered communication catch-up system.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://app.slack.com/*",
    "https://discord.com/*",
    "https://teams.microsoft.com/*",
    "https://mail.google.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": [
        "assets/adapter.ts-loader-D-lKQWdu.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-Dd-GQcj_.js"
      ],
      "matches": [
        "https://web.telegram.org/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-B0TUkk64.js"
      ],
      "matches": [
        "https://app.slack.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-rz2LKNn7.js"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-Dz5zqoV5.js"
      ],
      "matches": [
        "https://teams.microsoft.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-o4tuhLDM.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open CatchUp"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-Tk2V56Jq.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-XmlzknLw.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-CvMu5LrJ.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://discord.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-CwvI5oUv.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-DZiTQ1e8.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-BVPgsV5Q.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-DrF8Ei5d.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
