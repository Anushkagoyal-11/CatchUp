{
  "manifest_version": 3,
  "name": "CatchUp Universal",
  "version": "1.0.0",
  "description": "AI-powered communication catch-up system.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://app.slack.com/*",
    "https://discord.com/*",
    "https://teams.microsoft.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": [
        "assets/adapter.ts-loader-DSgQZSlG.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-_fveuLw7.js"
      ],
      "matches": [
        "https://web.telegram.org/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-BdhFDm-_.js"
      ],
      "matches": [
        "https://app.slack.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-CnMllEJx.js"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-B7jAFRCp.js"
      ],
      "matches": [
        "https://teams.microsoft.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-Cs0SvevA.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open CatchUp"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-CwPjXbG9.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-8eW7eyRP.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-C2TM9O98.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://discord.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-DPBDQAUF.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-BfsNLL16.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-71Z4Ok0B.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-DzsZ2Khz.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
