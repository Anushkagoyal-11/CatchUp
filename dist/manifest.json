{
  "manifest_version": 3,
  "name": "CatchUp Universal",
  "version": "1.0.0",
  "description": "AI-powered communication catch-up system.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://app.slack.com/*",
    "https://discord.com/*",
    "https://teams.microsoft.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": [
        "assets/adapter.ts-loader-BHhRneti.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-TJmRUj3J.js"
      ],
      "matches": [
        "https://web.telegram.org/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-DAvV1G2g.js"
      ],
      "matches": [
        "https://app.slack.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-DDJqUssT.js"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-DP5CW3kA.js"
      ],
      "matches": [
        "https://teams.microsoft.com/*"
      ]
    },
    {
      "js": [
        "assets/adapter.ts-loader-BlX00KXw.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open CatchUp"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-Cs26vrGD.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-Z6SGDr7a.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-BxENCSNa.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://discord.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-Clk0rFeO.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-ChfZVO6C.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "resources": [
        "assets/BaseAdapter-Dl4brJyi.js",
        "assets/message-schema-1hx2mHKL.js",
        "assets/adapter.ts-DkxqP9WX.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
